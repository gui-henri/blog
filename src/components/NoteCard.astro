---
import type { CollectionEntry } from 'astro:content';
import TagChip from './TagChip.astro';

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { title, pubDate, tags } = note.data;
const formatted = pubDate.toLocaleDateString('en-CA', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});
---

<article class="entry">
  <time class="entry-date" datetime={pubDate.toISOString()}>{formatted}</time>
  <h2 class="entry-title" style="font-size:1.02rem;"><a href={`/notes/${note.id}`}>{title}</a></h2>
  <div class="entry-tags">
    <div class="tags">
      {tags.map((tag) => <TagChip tag={tag} />)}
    </div>
  </div>
</article>
