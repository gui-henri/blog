---
import BaseLayout from './BaseLayout.astro';
import TagChip from '../components/TagChip.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, tags = [] } = Astro.props;
const formatted = pubDate.toLocaleDateString('en-CA', {
  year: 'numeric',
  month: 'long',
  day: '2-digit',
});
---

<BaseLayout title={title} description={description}>
  <article class="article wrap">
    <header class="article-head">
      <div class="article-meta">
        <time datetime={pubDate.toISOString()}>{formatted}</time>
        {updatedDate && (
          <span>updated {updatedDate.toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: '2-digit' })}</span>
        )}
        <span class="label">essay</span>
      </div>
      <h1>{title}</h1>
      <p class="lede" style="font-size:1.05em;">{description}</p>
      <div class="tags" style="margin-top:0.9rem;">
        {tags.map((tag) => <TagChip tag={tag} />)}
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
