---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import NoteCard from '../../components/NoteCard.astro';

export const getStaticPaths = (async () => {
  const [posts, notes] = await Promise.all([
    getCollection('posts', ({ data }) => !data.draft),
    getCollection('notes', ({ data }) => !data.draft),
  ]);
  const allTags = new Set<string>();
  for (const post of posts) post.data.tags.forEach((t) => allTags.add(t));
  for (const note of notes) note.data.tags.forEach((t) => allTags.add(t));
  return [...allTags].map((tag) => ({
    params: { tag },
    props: { tag, posts, notes },
  }));
}) satisfies GetStaticPaths;

const { tag, posts, notes } = Astro.props;
const taggedPosts = posts
  .filter((post) => post.data.tags.includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const taggedNotes = notes
  .filter((note) => note.data.tags.includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`#${tag}`}>
  <div class="wrap">
    <h1 class="label"># {tag}</h1>
    <section class="section" style="margin-top:1.5rem;">
      {taggedPosts.map((post) => <PostCard post={post} />)}
      {taggedNotes.map((note) => <NoteCard note={note} />)}
      {taggedPosts.length === 0 && taggedNotes.length === 0 && <p>Nothing tagged yet.</p>}
    </section>
  </div>
</BaseLayout>
